# Copy to .env.local in service/ for local dev.

PORT=8080

# Supabase project (service role key — trusted backend only, never expose to a browser bundle)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Chat / summarization (Anthropic — no native embeddings API)
ANTHROPIC_API_KEY=your_anthropic_api_key
CHAT_MODEL=claude-haiku-4-5

# Embeddings (Voyage AI — Anthropic's recommended embeddings partner, separate account/key)
VOYAGE_API_KEY=your_voyage_api_key
EMBEDDING_MODEL=voyage-3-lite

# Budget / rate-limit caps (kept low to hold real spend near $0).
# Anthropic and Voyage are billed separately — each gets its own cap.
AI_MONTHLY_TOKEN_CAP=200000
AI_REQUESTS_PER_DAY_CAP=50
AI_MAX_QPS=1
VOYAGE_MONTHLY_TOKEN_CAP=200000
