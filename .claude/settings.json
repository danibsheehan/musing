{
  "enabledPlugins": {
    "foundations@dani-foundations": true
  },
  "extraKnownMarketplaces": {
    "dani-foundations": {
      "source": {
        "source": "github",
        "repo": "danibsheehan/dani-foundations"
      }
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm audit*)",
      "Bash(npx prettier*)",
      "Bash(gh pr create*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)"
    ]
  }
}
