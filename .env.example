# Copy to .env.local in the REPO ROOT (next to package.json). Vite does not load env from src/.
# GitHub Actions: add the same keys as repository secrets for the Pages workflow.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional: AI second-brain layer (musing-ai-service, see service/). Requires Supabase to
# also be configured above — every AI endpoint authenticates via the Supabase session.
VITE_AI_SERVICE_URL=https://YOUR-SERVICE.run.app

# Optional: simulate GitHub Pages base path locally, e.g. VITE_BASE_PATH=/musing/
